---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';
import { readingTime } from '../../utils/reading-time';
import { site } from '../../data/site';
import { breadcrumbSchema, businessRef } from '../../utils/schema';

interface Props {
  post: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = new URL(Astro.url.pathname, Astro.site);
const postSchema = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  url: canonical,
  inLanguage: 'bs-BA',
  author: { '@type': 'Person', name: site.founder },
  publisher: businessRef,
  image: new URL('/og-image.png', Astro.site).toString(),
}, breadcrumbSchema([['Blog', '/blog'], [post.data.title, Astro.url.pathname]])];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  schema={postSchema}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
>
  <section class="section aw-section">
    <div class="container">
      <article class="aw-prose">
        <p class="aw-blog-meta mb-3">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {' · '}
          {readingTime(post.body ?? '')}
        </p>

        <h1 class="title is-1 mb-5">{post.data.title}</h1>

        <div class="mb-6">
          {post.data.tags.map((tag) => <span class="aw-tag">#{tag}</span>)}
        </div>

        <Content />
      </article>

      <p class="mt-6">
        <a href="/blog">← Nazad na sve članke</a>
      </p>
    </div>
  </section>
</BaseLayout>
