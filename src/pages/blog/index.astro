---
import BlogCard from '../../components/BlogCard.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../../utils/reading-time';
import { breadcrumbSchema } from '../../utils/schema';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog — savjeti o web stranicama i lokalnom SEO-u"
  description="Praktični savjeti za lokalne firme u BiH: izrada web stranica, Google Business profil, lokalni SEO i online marketing."
  schema={breadcrumbSchema([['Blog', '/blog']])}
>
  <PageHero
    eyebrow="Blog"
    title="Savjeti za lokalne firme."
    subtitle="Kako da vas klijenti pronađu na Googleu, koliko košta web stranica i šta zaista donosi pozive — bez tehničkog žargona."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="columns is-multiline">
            {
              posts.map((post) => (
                <div class="column is-4">
                  <BlogCard
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    tags={post.data.tags}
                    href={`/blog/${post.id}/`}
                    readingTime={readingTime(post.body ?? '')}
                  />
                </div>
              ))
            }
          </div>
        ) : (
          <p class="has-text-centered">
            Još nema članaka. Navratite uskoro — ili nam <a href="/kontakt">javite</a>
            o čemu biste voljeli čitati.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
