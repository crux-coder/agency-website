---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Stranica nije pronađena"
  description="Stranica koju tražite ne postoji. Vratite se na početnu stranicu."
>
  <PageHero
    eyebrow="Greška 404"
    title="Stranica nije pronađena."
    subtitle="Stranica koju tražite je premještena, preimenovana ili nikada nije postojala."
    compact
  >
    <div class="buttons is-centered mt-5">
      <a class="button is-primary is-medium" href="/">Nazad na početnu</a>
      <a class="button is-medium is-outlined aw-btn-ghost" href="/kontakt">Kontakt</a>
    </div>
  </PageHero>
</BaseLayout>