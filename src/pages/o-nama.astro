---
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { team, values } from '../data/team';
import { breadcrumbSchema } from '../utils/schema';
---

<BaseLayout
  title="O nama"
  description={`${site.name} je web agencija iz ${site.address.cityGenitive} koja pravi web stranice za lokalne firme širom Bosne i Hercegovine.`}
  schema={breadcrumbSchema([['O nama', '/o-nama']])}
>
  <PageHero
    eyebrow="O nama"
    title="Mala agencija, veliki fokus."
    subtitle="Radimo isključivo s lokalnim firmama — jer znamo koliko je važno da vas klijenti iz vašeg grada pronađu prije konkurencije."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <h2 class="title is-2 mb-4">Zašto postojimo</h2>
          <div class="content">
            <p>
              Većina malih firmi u BiH i dalje živi od preporuka. To je odlično —
              ali danas i ta preporuka završi na Googleu: klijent ukuca vaše ime
              ili uslugu i grad, i odluči na osnovu onoga što vidi.
            </p>
            <p>
              Velike agencije su skupe i spore, a „rođak koji zna praviti
              sajtove” rijetko misli na Google. Mi smo između: profesionalna
              stranica, jasna cijena u KM i jedna osoba s kojom stalno komunicirate.
            </p>
            <p>
              Gradimo brze stranice, optimizovane za lokalne pretrage, i
              ostajemo uz vas i nakon objave — za izmjene, savjete i rast.
            </p>
          </div>
        </div>
        <div class="column is-5">
          <div class="box aw-hero-box">
            <p class="aw-eyebrow mb-3">Ukratko</p>
            <ul class="content">
              <li>Sjedište u {site.address.cityLocative}, radimo u cijeloj BiH</li>
              <li>Samo lokalne firme i mali biznisi</li>
              <li>Fiksne cijene u KM, bez skrivenih troškova</li>
              <li>Direktan kontakt — telefon, Viber, e-mail</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Čime se vodimo</p>
        <h2 class="title is-2">Naše vrijednosti</h2>
      </div>

      <div class="columns">
        {
          values.map((value, index) => (
            <div class="column is-4">
              <div class="box aw-card">
                <p class="aw-value-number mb-2">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="title is-5">{value.title}</h3>
                <p>{value.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Ko stoji iza agencije</p>
        <h2 class="title is-2">Radite direktno sa mnom</h2>
      </div>

      <div class="columns is-centered">
        {
          team.map((member) => (
            <div class="column is-5">
              <div class="box aw-card">
                <div class="is-flex is-align-items-center mb-4">
                  <span class="aw-avatar mr-4" aria-hidden="true">{member.initials}</span>
                  <div>
                    <h3 class="title is-5 mb-1">{member.name}</h3>
                    <p class="aw-form-note">{member.role}</p>
                  </div>
                </div>
                <p>{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Upoznajmo se"
    title="Kafa, poziv ili Viber — kako vama odgovara."
    text="Ispričajte nam o svom poslu. Reći ćemo vam iskreno šta vam treba, a šta ne."
  />
</BaseLayout>
