---
import { cities } from '../data/cities';
import { addressLine, navItems, site } from '../data/site';
import { telHref } from '../utils/phone';

const year = new Date().getFullYear();
---

<footer class="footer aw-footer">
  <div class="container">
    <div class="columns is-multiline">
      <div class="column is-4">
        <p class="title is-5 mb-2">{site.name}</p>
        <p>{site.tagline}</p>
      </div>

      <div class="column is-2">
        <p class="has-text-weight-semibold mb-3">Stranice</p>
        <ul>
          {
            navItems.map((item) => (
              <li class="mb-1">
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="column is-3">
        <p class="has-text-weight-semibold mb-3">Izrada web stranica</p>
        <ul>
          {
            cities.map((city) => (
              <li class="mb-1">
                <a href={`/izrada-web-stranica/${city.slug}/`}>{city.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="column is-3">
        <p class="has-text-weight-semibold mb-3">Kontakt</p>
        <address class="aw-footer-address">
          <p class="mb-1">{addressLine}</p>
          <p class="mb-1">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <p>
            <a href={telHref(site.phone)}>{site.phone}</a>
          </p>
        </address>
      </div>
    </div>

    <hr />

    <p class="is-size-7">© {year} {site.name}. Izrada web stranica za lokalne firme u BiH.</p>
  </div>
</footer>
